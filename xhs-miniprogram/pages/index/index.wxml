<scroll-view scroll-y class="container">
  <view class="header">
    <text class="title"><text class="highlight">XHS</text> Downloader</text>
    <text class="subtitle">Paste a Xiaohongshu link to extract HD media</text>
  </view>

  <view class="input-group">
    <input class="url-input" placeholder="Paste link here..." placeholder-class="input-placeholder" bindinput="onInput" value="{{inputUrl}}" confirm-type="search" bindconfirm="handleParse" />
    <button class="parse-btn" loading="{{loading}}" bindtap="handleParse">Parse</button>
  </view>

  <view wx:if="{{error}}" class="error-msg">
    <icon type="warn" size="18" color="#ff4d4d"></icon>
    <text>{{error}}</text>
  </view>

  <view wx:if="{{data}}" class="card">
    <view class="user-info">
      <image wx:if="{{data.user.avatar}}" src="{{data.user.avatar}}" class="avatar"></image>
      <view class="user-meta">
        <text class="nickname">{{data.user.nickname}}</text>
        <text class="note-type">{{data.type === 'video' ? 'Video Note' : 'Image Note'}}</text>
      </view>
    </view>

    <text class="note-title">{{data.title}}</text>
    <text class="note-desc">{{data.desc}}</text>

    <!-- Batch Download Button -->
    <view wx:if="{{data.type === 'normal' && data.images.length > 1}}" class="batch-btn" bindtap="handleDownloadAll">
      <text>Download All ({{data.images.length}}) Images</text>
    </view>

    <!-- Video Player -->
    <view wx:if="{{data.video}}" class="video-section">
      <video src="{{data.video}}" poster="{{data.images[0].original}}" class="video-player"></video>
      <button class="download-btn full-width" bindtap="handleDownloadVideo" data-url="{{data.video}}">Download Video</button>
    </view>

    <!-- Image Grid -->
    <view wx:else class="image-grid">
      <view wx:for="{{data.images}}" wx:key="index" class="image-item">
        <image src="{{item.url}}" mode="aspectFill" class="grid-img" bindtap="previewImage" data-current="{{item.original}}"></image>
        <button class="download-btn small" bindtap="handleDownloadImage" data-url="{{item.original}}">Save</button>
      </view>
    </view>
  </view>
</scroll-view>
