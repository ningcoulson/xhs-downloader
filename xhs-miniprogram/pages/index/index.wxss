/**index.wxss**/
.container {
  padding: 40rpx;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  display: block;
  margin-bottom: 16rpx;
}

.highlight {
  color: #ff2442;
  /* Simple gradient fallback */
}

.subtitle {
  color: #a1a1aa;
  font-size: 28rpx;
  display: block;
}

.input-group {
  display: flex;
  background: #1c1c1e;
  padding: 16rpx;
  border-radius: 24rpx;
  margin-bottom: 32rpx;
  border: 2rpx solid #27272a;
}

.url-input {
  flex: 1;
  color: #fff;
  padding: 0 20rpx;
  height: 88rpx;
}

.input-placeholder {
  color: #555;
}

.parse-btn {
  background: #ff2442;
  color: white;
  margin: 0;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 16rpx;
  padding: 0 40rpx;
}

.error-msg {
  background: rgba(255, 77, 77, 0.1);
  color: #ff4d4d;
  padding: 24rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  margin-bottom: 30rpx;
}

.card {
  background: #1c1c1e;
  border-radius: 24rpx;
  padding: 32rpx;
  width: 100%;
  box-sizing: border-box;
  animation: fadeIn 0.5s ease;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 4rpx solid #ff2442;
  margin-right: 20rpx;
}

.nickname {
  font-size: 32rpx;
  font-weight: 600;
  display: block;
}

.note-type {
  font-size: 24rpx;
  color: #a1a1aa;
}

.note-title {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 20rpx;
}

.note-desc {
  font-size: 28rpx;
  color: #a1a1aa;
  line-height: 1.6;
  display: block;
  margin-bottom: 40rpx;
}

.batch-btn {
  background: #ff2442;
  color: white;
  text-align: center;
  padding: 30rpx;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 36, 66, 0.3);
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.image-item {
  background: #000;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid #27272a;
  position: relative;
}

.grid-img {
  width: 100%;
  height: 300rpx;
  display: block;
}

.download-btn {
  background: #ff2442;
  color: white;
  font-size: 24rpx;
  margin: 0;
  border-radius: 0;
}

.download-btn.small {
  width: 100%;
  padding: 16rpx 0;
}

.download-btn.full-width {
  width: 100%;
  margin-top: 20rpx;
  border-radius: 16rpx;
}

.video-player {
  width: 100%;
  border-radius: 16rpx;
}
